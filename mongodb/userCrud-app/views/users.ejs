<!DOCTYPE html>
<html>
  <head>
    <title>All Users</title>
  </head>
  <body>
    <%- include('partials/navbar') %>

    <h2>Registered Users</h2>
    <ul>
      <% users.forEach(user => { %>
      <li><strong><%= user.name %></strong> - <%= user.email %></li>
      <% }) %>
    </ul>
  </body>
</html>
