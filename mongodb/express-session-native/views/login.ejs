<!DOCTYPE html>
<html>
  <head>
    <title>Login</title>
    <style>
      body {
        font-family: sans-serif;
        padding: 2rem;
        background: #f0f0f0;
      }
      form {
        max-width: 300px;
        margin: auto;
        background: #fff;
        padding: 1rem;
        border-radius: 5px;
      }
      input,
      button {
        width: 100%;
        margin: 0.5rem 0;
        padding: 0.5rem;
      }
      .error {
        color: red;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <h2 style="text-align: center">Login</h2>
    <% if (error) { %>
    <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <input name="username" placeholder="Username" required />
      <input name="password" type="password" placeholder="Password" required />
      <button type="submit">Login</button>
    </form>
  </body>
</html>
